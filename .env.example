# ---------------------------------------------------------------------------
# Database (PostgreSQL) — used by Prisma.
#
# Supabase (recommended hosted option): Dashboard → "Connect" → "ORMs" → Prisma.
#   DATABASE_URL = Transaction pooler (host ...pooler.supabase.com, port 6543)
#   DIRECT_URL   = Session pooler   (host ...pooler.supabase.com, port 5432)
# Replace [YOUR-PASSWORD] with your database password.
#
# Local Postgres alternative:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pantry_tracker?schema=public"
#   DIRECT_URL="postgresql://postgres:postgres@localhost:5432/pantry_tracker?schema=public"
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.[REF]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[REF]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Auth.js (NextAuth v5) — user authentication.
#   AUTH_SECRET: generate with `npx auth secret` (or `openssl rand -base64 33`).
#   AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET: a Google OAuth client. You can REUSE
#     the Gmail OAuth client — just add these redirect URIs to it:
#       http://localhost:3000/api/auth/callback/google
#       https://<your-app>.vercel.app/api/auth/callback/google
#   AUTH_TRUST_HOST: set "true" when running behind a proxy (e.g. Vercel).
# ---------------------------------------------------------------------------
AUTH_SECRET="generate-me"
AUTH_GOOGLE_ID="your-google-oauth-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"
AUTH_TRUST_HOST="true"

# ---------------------------------------------------------------------------
# Google Gemini — used for structured email parsing & recipe generation.
# Create a key at https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key"

# Which Gemini model to use. `gemini-flash-latest` tracks the current flash
# model and avoids "model gated for new users" errors. Override if needed.
GEMINI_MODEL="gemini-flash-latest"

# ---------------------------------------------------------------------------
# Gmail OAuth 2.0 credentials — used to read order emails.
# Create an OAuth client (type: Web application) in Google Cloud Console,
# enable the Gmail API, then run the OAuth consent flow to get a refresh token.
# Required scope: https://www.googleapis.com/auth/gmail.readonly
# ---------------------------------------------------------------------------
GMAIL_CLIENT_ID="your-gmail-oauth-client-id.apps.googleusercontent.com"
GMAIL_CLIENT_SECRET="your-gmail-oauth-client-secret"
GMAIL_REFRESH_TOKEN="your-gmail-oauth-refresh-token"

# The Gmail address whose mailbox is watched (usually "me").
GMAIL_USER_ID="me"

# ---------------------------------------------------------------------------
# Google Cloud Pub/Sub — optional shared-secret to verify webhook authenticity.
# Configure Pub/Sub push subscription to include this token as a query param:
#   https://your-app.com/api/webhooks/gmail?token=<PUBSUB_VERIFICATION_TOKEN>
# ---------------------------------------------------------------------------
PUBSUB_VERIFICATION_TOKEN="a-long-random-string"

# Google Cloud project id + Pub/Sub topic name, used by `npm run gmail:watch`
# to point the mailbox watch at your topic (projects/<id>/topics/<topic>).
GCP_PROJECT_ID="your-gcp-project-id"
PUBSUB_TOPIC="gmail-orders"

# For local dev/testing only: the user id to attribute inbound orders to when
# a webhook cannot be resolved to a specific user (single-tenant dev mode).
DEV_DEFAULT_USER_EMAIL="you@example.com"
