// Prisma schema for the Pantry & Expiry Tracking App.
// Run `npx prisma db push` after editing to sync the database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Supabase transaction pooler, port 6543) — used at runtime.
  url       = env("DATABASE_URL")
  // Direct/session connection (port 5432) — used for `prisma db push` & migrations,
  // which run DDL that PgBouncer's transaction mode can't handle.
  directUrl = env("DIRECT_URL")
}

// ===========================================================================
// Auth.js (NextAuth v5) adapter models
// Required by @auth/prisma-adapter. `Account`/`Session`/`VerificationToken`
// are managed by Auth.js; do not write to them directly.
// ===========================================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ===========================================================================
// Domain models
// ===========================================================================

/// A registered user. Authenticates via Auth.js; belongs to one or more Houses.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? // set by Auth.js
  image         String?

  /// The house whose pantry the user is currently viewing/acting on.
  activeHouseId String?

  memberships    HouseMember[]
  purchasedItems PantryItem[]  @relation("PurchasedBy")
  orderLogs      OrderLog[]
  accounts       Account[]
  sessions       Session[]
  pushSubscriptions PushSubscription[]
  createdMealTemplates MealTemplate[] @relation("MealTemplateCreatedBy")
  loggedMeals          MealLog[]      @relation("MealLogLoggedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

/// A shared household pantry. Members collaborate on one inventory.
model House {
  id          String @id @default(cuid())
  name        String
  createdById String

  /// Shareable code used to join the house via invite link.
  joinCode String @unique @default(cuid())

  members     HouseMember[]
  pantryItems PantryItem[]
  orderLogs   OrderLog[]
  mealTemplates MealTemplate[]
  mealLogs      MealLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("houses")
}

/// Join table linking a User to a House with a role.
model HouseMember {
  id       String   @id @default(cuid())
  userId   String
  houseId  String
  role     Role     @default(MEMBER)
  joinedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  house House @relation(fields: [houseId], references: [id], onDelete: Cascade)

  @@unique([userId, houseId])
  @@index([houseId])
  @@map("house_members")
}

enum Role {
  OWNER
  MEMBER
}

/// A single physical item currently (or formerly) in a house's pantry.
model PantryItem {
  id      String @id @default(cuid())
  houseId String
  house   House  @relation(fields: [houseId], references: [id], onDelete: Cascade)

  /// Who bought/added this item (member-level attribution). Nullable so an
  /// item survives if the purchasing member is later removed.
  purchasedById String?
  purchasedBy   User?   @relation("PurchasedBy", fields: [purchasedById], references: [id], onDelete: SetNull)

  rawName            String // Original name as it appeared on the order (e.g. "Amul Taaza Milk 500ml")
  normalizedCategory String // One of the categories in lib/categories.ts (e.g. "Dairy")
  quantity           Float  @default(1)
  unit               String @default("unit") // e.g. "pcs", "g", "ml", "pack"

  purchasedAt DateTime @default(now())
  expiresAt   DateTime // Computed from category shelf-life defaults

  source     String  @default("manual") // "instamart" | "blinkit" | "zepto" | "manual"
  isConsumed Boolean @default(false)

  /// Set when we've sent the "expiring soon" push, so we don't notify twice.
  expiryNotifiedAt DateTime?

  mealDeductions MealLogDeduction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([houseId, isConsumed, expiresAt])
  @@map("pantry_items")
}

/// A browser Web Push subscription belonging to a user (one per device/browser).
model PushSubscription {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint String @unique
  p256dh   String // client public key
  auth     String // client auth secret

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

// ===========================================================================
// Meal logging
// ===========================================================================

/// How a meal log was created. Extensible for future input methods
/// (barcode/voice/AI) without schema changes to consumers.
enum MealSource {
  TEMPLATE
  ADHOC
  AI
  BARCODE
  VOICE
  RECURRING
}

/// A reusable meal definition (e.g. "Coffee") with a list of ingredients.
/// Ingredients are stored by NAME (not pantry-item id) so they match against
/// whatever inventory exists at log time.
model MealTemplate {
  id          String  @id @default(cuid())
  houseId     String
  house       House   @relation(fields: [houseId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?   @relation("MealTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  name       String
  icon       String  @default("🍽️")
  isFavorite Boolean @default(false)

  /// Open-ended bag for future features (nutrition, tags, recurring config).
  metadata Json?

  ingredients MealTemplateIngredient[]
  mealLogs    MealLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([houseId])
  @@map("meal_templates")
}

/// One ingredient line of a template. Not tied to any pantry item.
model MealTemplateIngredient {
  id         String @id @default(cuid())
  templateId String
  template   MealTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  name     String // e.g. "Milk"
  quantity Float  @default(1)
  unit     String @default("pcs")

  /// Optional extra names/brands to help the matcher (e.g. ["Amul", "Nandini"]).
  aliases  String[] @default([])
  /// If true, a missing match won't block logging.
  optional Boolean  @default(false)
  sortOrder Int     @default(0)

  @@index([templateId])
  @@map("meal_template_ingredients")
}

/// A recorded meal. Deductions capture exactly what was removed, enabling undo.
model MealLog {
  id         String @id @default(cuid())
  houseId    String
  house      House  @relation(fields: [houseId], references: [id], onDelete: Cascade)
  loggedById String?
  loggedBy   User?  @relation("MealLogLoggedBy", fields: [loggedById], references: [id], onDelete: SetNull)
  templateId String?
  template   MealTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  name    String
  icon    String     @default("🍽️")
  source  MealSource @default(TEMPLATE)
  note    String?
  metadata Json?

  loggedAt DateTime  @default(now())
  /// Set when the log is undone; deductions are restored and it's hidden.
  undoneAt DateTime?

  deductions MealLogDeduction[]

  createdAt DateTime @default(now())

  @@index([houseId, loggedAt])
  @@map("meal_logs")
}

/// A single draw from inventory for one ingredient of a meal log.
/// One ingredient may span several rows (FIFO across multiple pantry items).
/// Rows also record missing/skipped ingredients (pantryItemId = null).
model MealLogDeduction {
  id        String  @id @default(cuid())
  mealLogId String
  mealLog   MealLog @relation(fields: [mealLogId], references: [id], onDelete: Cascade)

  ingredientName String
  requestedQty   Float
  requestedUnit  String
  status         String // "deducted" | "partial" | "missing" | "skipped" | "unit_mismatch"

  /// The pantry item drawn from (null for missing/skipped lines).
  pantryItemId String?
  pantryItem   PantryItem? @relation(fields: [pantryItemId], references: [id], onDelete: SetNull)
  /// Amount removed, expressed in the pantry item's own unit (for exact undo).
  deductedQty     Float   @default(0)
  deductedUnit    String?
  /// Whether this deduction set the pantry item to consumed (restore on undo).
  consumedFlagged Boolean @default(false)

  @@index([mealLogId])
  @@map("meal_log_deductions")
}

/// Idempotency + audit log of every order email we have processed.
model OrderLog {
  id      String @id @default(cuid())
  houseId String
  house   House  @relation(fields: [houseId], references: [id], onDelete: Cascade)

  /// The member whose mailbox the order arrived in.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  messageId   String // Gmail message id — used to avoid double-processing
  platform    String // "instamart" | "blinkit" | "zepto"
  processedAt DateTime @default(now())

  @@unique([messageId])
  @@index([houseId])
  @@index([userId])
  @@map("order_logs")
}
